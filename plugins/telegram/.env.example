# telegram-topics proxy configuration.
#
# Copy to `.env` (in this plugin dir, or in ~/.claude/channels/telegram-topics/)
# and fill in. The real process environment always wins over a .env file.
# This is the CONTRACT: exactly these keys, nothing else. A `.env` key that is
# not one of these is a mistake (decide deliberately whether it belongs here).
# Never commit the filled-in `.env` (it is gitignored) - the token is a secret.

# The ONE bot token the proxy owns. Only the proxy may run getUpdates on it.
# BotFather -> /setprivacy -> Disable, so the bot sees every topic message.
TELEGRAM_BOT_TOKEN=

# The forum supergroup id (looks like -1001234567890). Updates from any other
# chat are dropped: this is the access control. Enable Topics on the group.
TELEGRAM_GROUP_CHAT_ID=

# Working directory for every spawned topic-Claude. Optional; defaults to $HOME.
TELEGRAM_TOPICS_SPAWN_DIR=

# HTTP port the MCP clients long-poll / POST to. Optional; defaults to 8790.
TELEGRAM_PROXY_PORT=

# Channel marketplace ref passed to the launcher's
# --dangerously-load-development-channels. Optional; defaults to
# plugin:telegram@zamua. Change only if you renamed the marketplace.
TELEGRAM_TOPICS_MARKETPLACE=

# Secret drop: a "/secret <name>" message (value on the next line) from THIS
# Telegram user id is written to TELEGRAM_TOPICS_SECRETS_DIR/<name> (mode 0600)
# and deleted from the chat before any topic-Claude can see it. Optional; unset
# = feature off. The group gate alone admits every member, hence the user gate.
TELEGRAM_TOPICS_SECRETS_USER_ID=

# Where dropped secrets land. Optional; defaults to ~/keys.
TELEGRAM_TOPICS_SECRETS_DIR=

# Nightly restart hour (0-23, LOCAL time). Optional; unset/empty = disabled.
# When set, once a day at this hour the proxy kills every LIVE topic session;
# each one re-spawns with --resume (fresh claude + latest launcher, full history
# kept) on its next inbound message. Passive: idle sessions are not kept running.
TELEGRAM_TOPICS_NIGHTLY_RESTART_HOUR=

# Default model for every topic-Claude. PREFER AN ALIAS (opus / sonnet /
# haiku): aliases resolve to the newest model in that family, so a new
# release needs no config change. A pinned id (claude-opus-5) also works
# when you deliberately want to freeze a version. Optional; defaults to
# `fable`. Set `default` / `inherit` / empty to leave it unset (use the
# account default). Passed as the `--model` FLAG (not a settings key: a settings
# `model` is a default that a --resume'd session ignores; the flag overrides even
# on resume). Takes effect on each topic's next respawn. (The single-session
# bridge picks its own model separately.)
TELEGRAM_TOPICS_MODEL=

# Which terminal multiplexer hosts the detached topic-Claude sessions:
# `tmux` (default) or `herdr` (herdr.dev - per-agent state visibility, socket
# API, sessions survive client detach). Optional. Takes effect on the next
# proxy restart; sessions ALREADY running in the other multiplexer keep
# working (the proxy re-adopts what it finds in the registry) but can only be
# killed/respawned by the currently selected backend, so migrate live sessions
# deliberately: kill each session in the old backend and let its next inbound
# message respawn it (same claude session id -> same conversation) under the
# new one. herdr prerequisites (see CLAUDE.md "Multiplexer backends"): the
# herdr server must be running (e.g. a launchd agent running `herdr server`),
# and on macOS grant Full Disk Access to the herdr binary if your sessions
# need it (herdr becomes the TCC "responsible process", as tmux is today).
TELEGRAM_TOPICS_MULTIPLEXER=

# The #square: one forum topic hosting ALL agent-to-agent conversations (see
# CLAUDE.md "The square"). Unset/empty = square disabled (all square tools and
# endpoints return errors; nothing else changes). Set to the topic's thread id.
TELEGRAM_TOPICS_SQUARE_TOPIC_ID=

# Hours an idle square conversation stays routable (registry pruning only -
# the Telegram thread stays readable forever). Optional; defaults to 48.
TELEGRAM_TOPICS_CONV_TTL_HOURS=

# ---- provider/model routing -------------------------------------------------
# Telegram user id allowed to run /model and /usage and to approve or deny an
# auto-mode action request. Optional; defaults to TELEGRAM_TOPICS_SECRETS_USER_ID.
# Every route still runs the Claude Code harness and resumes the same Claude
# session UUID.
TELEGRAM_TOPICS_ADMIN_USER_ID=

# Loopback Anthropic-compatible bridge used for ChatGPT/Codex and OpenCode Go.
# Defaults shown. The bridge itself is managed by pm2.
TELEGRAM_PROVIDER_PROXY_URL=http://127.0.0.1:18765
TELEGRAM_PROVIDER_PROXY_BIN=claude-code-proxy
# CLI used for model metadata (names, effort variants, context windows).
TELEGRAM_OPENCODE_BIN=opencode

# Provider capacity polling interval. Anthropic also reports capacity through
# Claude's status line; Codex and OpenCode Go are probed here. Defaults to 5.
TELEGRAM_PROVIDER_CAPACITY_POLL_MINUTES=5

# Existing OpenCode credential store read by the capacity probe and bridge
# start adapter. The key is never copied into this .env. Defaults to this path.
TELEGRAM_OPENCODE_AUTH_FILE=

# Voice-note auto-transcription (default on). Inbound Telegram voice messages
# are transcribed locally (whisper.cpp) and delivered to the topic-Claude as
# text behind a short "[voice note, auto-transcribed...]" tag. Fail-open: if
# ffmpeg / whisper-cli / the model file is missing, or transcription errors,
# the message falls back to "(voice message)" with the attachment meta intact.
# Set to false to disable.
TELEGRAM_TOPICS_VOICE_TRANSCRIBE=

# Paths for the transcription toolchain. Defaults: /opt/homebrew/bin/ffmpeg,
# /opt/homebrew/bin/whisper-cli, and
# ~/.local/share/whisper-models/ggml-large-v3-turbo-q5_0.bin (the 574MB q5
# quant - download from huggingface.co/ggerganov/whisper.cpp). Override when
# the binaries or model live elsewhere.
TELEGRAM_TOPICS_FFMPEG_BIN=
TELEGRAM_TOPICS_WHISPER_BIN=
TELEGRAM_TOPICS_WHISPER_MODEL=

# Vocabulary bias for voice transcription. Whisper conditions its decoder on
# this text, which fixes stack jargon a general model mangles (measured:
# kubectl -> "cubectal", traefik -> "Trifik", 502 -> "500 too"). Optional;
# defaults to a built-in glossary of this stack's terms. Keep any override
# SHORT - whisper's prompt window is ~224 tokens and a bloated list dilutes
# the bias. Empty string disables biasing entirely.
TELEGRAM_TOPICS_WHISPER_PROMPT=
