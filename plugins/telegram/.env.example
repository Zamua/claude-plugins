# telegram-topics proxy configuration.
#
# Copy to `.env` (in this plugin dir, or in ~/.claude/channels/telegram-topics/)
# and fill in. The real process environment always wins over a .env file.
# This is the CONTRACT: exactly these keys, nothing else. A `.env` key that is
# not one of these is a mistake (decide deliberately whether it belongs here).
# Never commit the filled-in `.env` (it is gitignored) - the token is a secret.

# The ONE bot token the proxy owns. Only the proxy may run getUpdates on it.
# BotFather -> /setprivacy -> Disable, so the bot sees every topic message.
TELEGRAM_BOT_TOKEN=

# The forum supergroup id (looks like -1001234567890). Updates from any other
# chat are dropped: this is the access control. Enable Topics on the group.
TELEGRAM_GROUP_CHAT_ID=

# Working directory for every spawned topic-Claude. Optional; defaults to $HOME.
TELEGRAM_TOPICS_SPAWN_DIR=

# HTTP port the MCP clients long-poll / POST to. Optional; defaults to 8790.
TELEGRAM_PROXY_PORT=

# Channel marketplace ref passed to the launcher's
# --dangerously-load-development-channels. Optional; defaults to
# plugin:telegram@zamua. Change only if you renamed the marketplace.
TELEGRAM_TOPICS_MARKETPLACE=
