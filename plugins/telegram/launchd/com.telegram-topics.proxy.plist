<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template for the durable proxy: native-macOS auto-start
     (RunAtLoad) + auto-restart on crash (KeepAlive), so the plugin needs NO
     external service manager. Install with scripts/install-launchd.sh, which
     fills the two placeholders below (the start-proxy.sh path + a log path) and
     loads it. The proxy reads its token from a .env (this plugin dir or
     ~/.claude/channels/telegram-topics/), so no secret goes in this plist. It
     OWNS the token's getUpdates slot - stop any other poller on the same token
     first. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.telegram-topics.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@STARTPROXY@</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
